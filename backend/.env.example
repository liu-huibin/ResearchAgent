# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=researchmate_app
MYSQL_PASSWORD=replace-with-a-long-random-password
# Alternatively keep MYSQL_PASSWORD empty and point to a private local file.
MYSQL_PASSWORD_FILE=
MYSQL_DATABASE=research_mate
MYSQL_REQUIRE_TLS=true
MYSQL_SSL_CA=C:/ProgramData/MySQL/MySQL Server 9.0/Data/ca.pem
MYSQL_SSL_VERIFY=true

# Browser/API security. API_TOKEN is mandatory for non-loopback backend binds.
# Generate a random value with at least 32 characters; never commit a real token.
API_TOKEN=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Qwen LLM API (OpenAI-compatible)
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen-plus

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads

# Logging
LOG_LEVEL=INFO
LOG_DIR=log
